        "code": "<template>\n  <div class=\"page\">\n    <h2>局部组件与 props</h2>\n    <duty-item v-for=\"(t, i) in dutyList\" :key=\"i\" :text=\"t.text\" :done=\"t.done\"></duty-item>\n    <button @click=\"toggleFirst\">切换第一项状态</button>\n  </div>\n</template>\n<script>\n// 局部子组件（对象形式定义，template 为字符串）\nvar DutyItem = {\n  props: ['text', 'done'],\n  template: '<div class=\"todo\" :class=\"{ done: done }\">{{ done ? \"√\" : \"○\" }} {{ text }}</div>'\n}\nexport default {\n  components: { 'duty-item': DutyItem },\n  data() {\n    return {\n      dutyList: [\n        { text: '学习组件语法', done: true },\n        { text: '写一个小项目', done: false },\n        { text: '复习组件通信', done: false }\n      ]\n    }\n  },\n  methods: {\n    toggleFirst() {\n      this.dutyList[0].done = !this.dutyList[0].done\n    }\n  }\n}\n</script>\n<style>\n.page { padding: 20px; }\nh2 { color: #2f9e7d; margin-top: 0; }\n.duty {\n  padding: 10px 14px; margin-top: 8px; border-radius: 8px;\n  background: #f6f8fa; font-size: 14px;\n}\n.duty.done { color: #aaa; text-decoration: line-through; }\nbutton {\n  margin-top: 12px; padding: 8px 16px; border: none; border-radius: 8px;\n  background: #2f9e7d; color: #fff; cursor: pointer;\n}\n</style>"
      },
      {
        "name": "生命周期 created / mounted",
        "desc": "钩子执行时机",
        "code": "<template>\n  <div class=\"page\">\n    <h2>生命周期</h2>\n    <p>打开控制台查看打印顺序</p>\n    <div class=\"stage\">{{ stage }}</div>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return { stage: '初始化中...' }\n  },\n  created() {\n    console.log('1. created：数据已就绪，DOM 还没有')\n    this.stage = 'created 已执行（DOM 未挂载）'\n  },\n  mounted() {\n    console.log('2. mounted：DOM 已挂载完成')\n    this.stage = 'mounted 已执行（DOM 就绪）'\n  }\n}\n</script>\n<style>\n.page { padding: 20px; }\nh2 { color: #2f9e7d; margin-top: 0; }\np { color: #888; font-size: 13px; }\n.stage {\n  margin-top: 12px; padding: 16px; border-radius: 10px;\n  background: #f0faf5; color: #1c7c54; font-size: 15px;\n}\n</style>"
