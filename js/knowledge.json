      },
      {
        "name": "子组件展示 + 父组件汇总",
        "desc": "props 传值与 computed 配合",
        "code": "<template>\n  <div class=\"page\">\n    <h2>组件与计算属性配合</h2>\n    <fruit-row v-for=\"(f, i) in list\" :key=\"i\" :name=\"f.name\" :price=\"f.price\"></fruit-row>\n    <p class=\"sum\">共 {{ list.length }} 种，均价 ￥{{ avg }}</p>\n  </div>\n</template>\n<script>\nvar FruitRow = {\n  props: ['name', 'price'],\n  template: '<div class=\"row\"><span>{{ name }}</span><b>￥{{ price }}</b></div>'\n}\nexport default {\n  components: { 'fruit-row': FruitRow },\n  data() {\n    return {\n      list: [\n        { name: '青苹果', price: 6 },\n        { name: '甜橙', price: 4 },\n        { name: '沙糖桔', price: 5 }\n      ]\n    }\n  },\n  computed: {\n    avg() {\n      var s = 0\n      this.list.forEach(function (f) { s += f.price })\n      return Math.round(s / this.list.length)\n    }\n  }\n}\n</script>\n<style>\n.page { padding: 20px; }\nh2 { color: #2f9e7d; margin-top: 0; }\n.row { display: flex; justify-content: space-between; padding: 10px 12px; margin-top: 8px; background: #f6f8fa; border-radius: 8px; font-size: 14px; }\n.sum { margin-top: 12px; color: #1c7c54; font-size: 14px; }\n</style>"
