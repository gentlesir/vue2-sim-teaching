        "name": "数组变异与 $set / $nextTick",
        "desc": "增删改与更新时机",
        "code": "<template>\n  <div class=\"page\">\n    <h2>数组与对象更新</h2>\n    <p class=\"list\">{{ list.join(' / ') }}</p>\n    <div class=\"row\">\n      <button @click=\"list.push('丁')\">push</button>\n      <button @click=\"list.splice(1, 1)\">删第二项</button>\n      <button @click=\"list.reverse()\">reverse</button>\n    </div>\n    <button class=\"wide\" @click=\"addKey\">用 $set 给对象加字段</button>\n    <p class=\"tip\">obj.k2：{{ obj.k2 || '尚未添加' }}</p>\n    <p class=\"tip\">$nextTick 里累加的计数：{{ tick }}</p>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return { list: ['甲', '乙', '丙'], obj: { k1: 'A' }, tick: 0 }\n  },\n  methods: {\n    addKey() {\n      var self = this\n      this.$set(this.obj, 'k2', '由 $set 添加')\n      this.$nextTick(function () {\n        self.tick++\n      })\n    }\n  }\n}\n</script>\n<style>\n.page { padding: 20px; }\nh2 { color: #2f9e7d; margin-top: 0; }\n.list { font-size: 16px; font-weight: 600; }\nbutton { padding: 7px 12px; margin-right: 6px; border: none; border-radius: 8px; background: #2f9e7d; color: #fff; cursor: pointer; }\n.wide { display: block; margin-top: 10px; }\n.tip { color: #666; font-size: 13px; }\n</style>"
